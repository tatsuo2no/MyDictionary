<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp"
    android:layout_margin="8dp">

    <FrameLayout
        android:layout_width="124dp"
        android:layout_height="162dp">

        <View
            android:id="@+id/bookIconView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/cover_border_shape" />

        <ImageView
            android:id="@+id/bookCoverPatternView"
            android:layout_width="122dp"
            android:layout_height="160dp"
            android:layout_gravity="center"
            android:contentDescription="@null" />

        <!-- 「手動」並び順のときだけ表示するドラッグ用ハンドル。長押し（＝ブックオプションを開く）と
             干渉しないよう、ドラッグはこのハンドルを触ったときだけ開始する。 -->
        <ImageView
            android:id="@+id/dragHandleView"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="top|start"
            android:layout_margin="4dp"
            android:padding="3dp"
            android:background="@drawable/drag_handle_bg"
            android:src="@drawable/ic_drag_handle"
            android:contentDescription="@string/book_reorder_hint"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ブック名はカバーの中ではなく下に表示し、名前の長さでカードの横幅が変わらないよう、
         カバーと同じ幅(124dp)に固定して折り返す（長い場合は複数行になり、カードの高さだけ伸びる）。 -->
    <TextView
        android:id="@+id/bookTitleView"
        android:layout_width="124dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:maxLines="3" />

</LinearLayout>
